# ---- Server ----
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# ---- Database (Neon Postgres — must have pgvector and pg_trgm extensions enabled) ----
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require"

# ---- Redis (optional — falls back to in-memory rate limiting if not set) ----
REDIS_URL="redis://localhost:6379"

# ---- Auth ----
JWT_SECRET="change-this-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="change-this-to-a-different-long-random-string"
REFRESH_TOKEN_EXPIRES_IN="7d"
REFRESH_TOKEN_COOKIE_NAME="gv_refresh_token"

# ---- AI (Gemini) ----
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# ---- Duplicate detection ----
AADHAAR_HASH_SALT="change-this-to-a-random-salt-string"
DUPLICATE_SIMILARITY_THRESHOLD="0.45"

# ---- Overpass (OpenStreetMap) ----
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"

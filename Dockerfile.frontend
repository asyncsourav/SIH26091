FROM node:20-alpine AS base
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .

# Dev-server image (matches docker-compose's local-dev intent). For a
# production static build, swap the final stage for an `npm run build` +
# nginx-serve image instead.
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# Base URL of the backend API. Leave as-is for local dev (Vite proxies /api
# to the backend per vite.config.ts); set to your deployed backend URL in
# production (e.g. https://gram-vyapaar-api.onrender.com).
VITE_API_BASE_URL=/api

# Public map tile attribution note (OpenStreetMap — no API key required).
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
